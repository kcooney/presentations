    "@types/jest": "^29.5.14",
    "@types/reveal.js": "^5.0.5",
    "esbuild": "0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.4.2",

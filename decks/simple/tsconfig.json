{
  "compilerOptions": {
    "paths": {
      "*": ["./typings/*"]
    },
    "module": "es6",
    "target": "es6",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  "include": ["./src/**/*.ts"]
}

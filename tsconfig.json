{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2020", "ES2021.WeakRef", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist"
  },
  "include": ["./src/**/*.ts"]
}
